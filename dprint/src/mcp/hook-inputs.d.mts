/**
 * Argument types of the MCP tools called by `plugin/hooks/hooks.json`.
 *
 * @remarks
 * Generated by `scripts/hooks.mjs` from the hooks' `input` templates; do not edit. Regenerate with
 * `pnpm build` (or `node scripts/hooks.mjs`); `pnpm lint` fails while this file is stale. Every
 * member is optional: Claude Code fills it from the template, but a tool can also be called directly.
 *
 * @packageDocumentation
 */

/** Arguments of MCP tool `format_pre` (PreToolUse `Write|Edit` hook). */
export interface FormatPreInput {
  /** Template: `${cwd}`. */
  cwd?: string;
  /** Template: `${agent_id}`. */
  agent_id?: string;
  /** Template: `${session_id}`. */
  session_id?: string;
  /** Template: `${tool_name}`. */
  tool_name?: string;
  tool_input?: {
    /** Template: `${tool_input.file_path}`. */
    file_path?: string;
    /** Template: `${tool_input.content}`. */
    content?: string;
    /** Template: `${tool_input.old_string}`. */
    old_string?: string;
    /** Template: `${tool_input.new_string}`. */
    new_string?: string;
    /** Template: `${tool_input.replace_all}`. */
    replace_all?: string;
  };
}

/** Arguments of MCP tool `worktree_entered` (PostToolUse `EnterWorktree` hook). */
export interface WorktreeEnteredInput {
  /** Template: `${agent_id}`. */
  agent_id?: string;
  /** Template: `${session_id}`. */
  session_id?: string;
  tool_response?: {
    /** Template: `${tool_response.worktreePath}`. */
    worktreePath?: string;
  };
}

/** Arguments of MCP tool `worktree_exited` (PostToolUse `ExitWorktree` hook). */
export interface WorktreeExitedInput {
  /** Template: `${agent_id}`. */
  agent_id?: string;
  /** Template: `${session_id}`. */
  session_id?: string;
  tool_response?: {
    /** Template: `${tool_response.restoredCwd}`. */
    restoredCwd?: string;
  };
}

/** Arguments of MCP tool `cwd_changed` (CwdChanged hook). */
export interface CwdChangedInput {
  /** Template: `${agent_id}`. */
  agent_id?: string;
  /** Template: `${session_id}`. */
  session_id?: string;
  /** Template: `${new_cwd}`. */
  new_cwd?: string;
}

/** Tool name to argument type, for every tool `hooks.json` calls (the server must implement exactly these). */
export interface HookInputs {
  /** {@link FormatPreInput} */
  format_pre: FormatPreInput;
  /** {@link WorktreeEnteredInput} */
  worktree_entered: WorktreeEnteredInput;
  /** {@link WorktreeExitedInput} */
  worktree_exited: WorktreeExitedInput;
  /** {@link CwdChangedInput} */
  cwd_changed: CwdChangedInput;
}
