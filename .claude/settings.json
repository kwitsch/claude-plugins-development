{
  "permissions": {
    "allow": [
      "AskUserQuestion",
      "Bash(pnpm install*)",
      "Bash(pnpm build*)",
      "Bash(pnpm -r build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm -r test*)",
      "Bash(pnpm --filter *)",
      "Bash(claude plugin validate *)"
    ],
    "deny": [
      "Edit(./*/plugin/**/*.mjs)",
      "Edit(./*/plugin/.claude-plugin/plugin.json)",
      "Edit(./*/plugin/**/*.ts)",
      "Edit(./*/plugin/**/*.mts)",
      "Edit(./*/plugin/**/*.test.*)",
      "Edit(./*/plugin/**/tests/**)",
      "Edit(./*/plugin/**/CLAUDE.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/oxlint-edited.sh",
            "asyncRewake": true,
            "timeout": 120
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "universal-format@kwitsch-plugins": false,
    "universal-lint@kwitsch-plugins": false,
    "dprint@kwitsch-plugins": true
  },
  "extraKnownMarketplaces": {
    "kwitsch-plugins": {
      "source": {
        "source": "github",
        "repo": "kwitsch/claude-plugins"
      }
    }
  }
}
