{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./src/hooks/session-start.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./src/hooks/stop.ts",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
