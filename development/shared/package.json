{
  "name": "@kwitsch/claude-code-plugin-shared",
  "version": "0.1.0",
  "description": "Build-time shared code for kwitsch Claude Code plugins (path scope, dual-era MCP loop, graphmind paths); inlined by the consuming plugin's build.",
  "repository": { "type": "git", "url": "git+https://github.com/kwitsch/claude-plugins-development.git", "directory": "development/shared" },
  "license": "MIT",
  "author": "Kwitsch",
  "type": "module",
  "exports": {
    "./scope": { "types": "./dist/scope.d.mts", "default": "./dist/scope.mjs" },
    "./mcp-core": { "types": "./dist/mcp-core.d.mts", "default": "./dist/mcp-core.mjs" },
    "./graphmind-paths": { "types": "./dist/graphmind-paths.d.mts", "default": "./dist/graphmind-paths.mjs" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config \"$(git rev-parse --show-toplevel)/vitest.config.mts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "tsdown": "0.23.7"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": { "optional": true }
  },
  "publishConfig": { "registry": "https://npm.pkg.github.com" }
}
