{
  "name": "taskflow",
  "version": "3.2.0",
  "private": true,
  "description": "Runs a spec-driven design and delivery pipeline for a task (/taskflow:build-task) and reviews and fixes a branch's changes (/taskflow:review-task).",
  "author": {
    "name": "Kwitsch"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test:plugin": "node ../development/scripts/plugin-test.ts",
    "test": "vitest run --config \"$(git rev-parse --show-toplevel)/vitest.config.mts\""
  },
  "devDependencies": {
    "@kwitsch/tsdown-preset-claude-code": "0.3.0",
    "claude-engine-vitest": "workspace:*",
    "tsdown": "0.23.7"
  },
  "claudePlugin": {},
  "pluginBuild": {
    "assets": [
      "skills/build-task/workflows/implement.md",
      "skills/build-task/workflows/ship.md",
      "skills/design-task/workflows/design.md",
      "skills/plan-task/workflows/plan.md",
      "skills/spec-task/workflows/spec.md",
      "workflows/build-task-design.workflow.js",
      "workflows/build-task-implement.workflow.js",
      "workflows/build-task-plan.workflow.js",
      "workflows/build-task-ship.workflow.js",
      "workflows/build-task-spec.workflow.js"
    ]
  }
}
