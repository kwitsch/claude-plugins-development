{
  "name": "cc-knowledge",
  "version": "2.2.0",
  "private": true,
  "description": "Answers questions about authoring Claude Code skills, agents, hooks, MCP servers, plugins and settings from bundled references, and reviews, creates, compresses and audits them.",
  "keywords": [
    "claude-code",
    "skills",
    "subagents",
    "hooks",
    "reference"
  ],
  "author": {
    "name": "Kwitsch"
  },
  "type": "module",
  "scripts": {
    "build": "node ../development/scripts/build-plugin.ts",
    "test": "vitest run --config \"$(git rev-parse --show-toplevel)/vitest.config.mts\""
  },
  "devDependencies": {
    "claude-engine-vitest": "workspace:*"
  },
  "claudePlugin": {},
  "pluginBuild": {
    "assets": [
      "skills/repository-audit/templates/init-dev-environment/SKILL.md.tmpl",
      "skills/repository-audit/templates/init-dev-environment/install.sh"
    ]
  }
}
