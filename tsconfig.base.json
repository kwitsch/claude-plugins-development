{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": [
        "./development/shared/src/*"
      ]
    },
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ]
  }
}
