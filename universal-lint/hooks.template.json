{
  "mod": "./src/hooks/register.ts",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./src/hooks/watch-paths.ts",
            "timeout": 30
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./src/hooks/watch-paths.ts",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:universal-lint:lint",
            "tool": "prompt_submitted",
            "timeout": 10,
            "input": {
              "cwd": "${cwd}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}"
            }
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:universal-lint:lint",
            "tool": "file_changed",
            "timeout": 100,
            "input": {
              "cwd": "${cwd}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "file_path": "${file_path}",
              "event": "${event}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:universal-lint:lint",
            "tool": "stop",
            "timeout": 100,
            "input": {
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "stop_hook_active": "${stop_hook_active}"
            }
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:universal-lint:lint",
            "tool": "stop",
            "timeout": 100,
            "input": {
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "stop_hook_active": "${stop_hook_active}"
            }
          }
        ]
      }
    ]
  }
}
