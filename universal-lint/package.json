{
  "name": "universal-lint",
  "version": "0.18.0",
  "private": true,
  "description": "Runs each language's standard linter, read-only, on the files Claude writes or that change in the project, and hands the findings to Claude to fix.",
  "keywords": [
    "hooks",
    "linting",
    "quality"
  ],
  "author": {
    "name": "Kwitsch"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config \"$(git rev-parse --show-toplevel)/vitest.config.mts\"",
    "test:plugin": "node ../development/scripts/plugin-test.ts"
  },
  "devDependencies": {
    "@kwitsch/tsdown-preset-claude-code": "0.4.2",
    "claude-engine-vitest": "workspace:*",
    "tsdown": "0.23.7"
  },
  "claudePlugin": {}
}
